# Clave de la API de Google Gemini (nivel gratuito). Necesaria para el análisis
# de imagen y para la búsqueda de alimentos con IA + PubMed. Vive solo en el servidor.
# Consíguela gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelo de Gemini a usar (por defecto gemini-2.5-flash, con nivel gratuito).
GEMINI_MODEL=gemini-2.5-flash

# Opcionales, para consultar PubMed con más cuota y sin límites de cortesía
# (ver https://www.ncbi.nlm.nih.gov/account/settings/ para obtener una api_key).
NCBI_API_KEY=
NCBI_EMAIL=

# Opcionales: almacén compartido (Upstash Redis, nivel gratuito) para que los
# alimentos generados por IA se guarden una sola vez y se compartan entre
# todas las visitas. Sin esto, la búsqueda con IA sigue funcionando igual,
# pero cada persona la repite para sí misma en vez de beneficiarse de lo que
# ya buscaron otros. Se crea en un par de clics desde el propio panel de
# Vercel: pestaña "Storage" del proyecto → "Create Database" → "Upstash for
# Redis" (o similar); Vercel añade estas variables automáticamente.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
