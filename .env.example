# Clave de la API de Google Gemini (nivel gratuito). Necesaria para el análisis
# de imagen y para la búsqueda de alimentos con IA + PubMed. Vive solo en el servidor.
# Consíguela gratis en https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opcional: modelo de Gemini a usar (por defecto gemini-2.5-flash, con nivel gratuito).
GEMINI_MODEL=gemini-2.5-flash

# Opcionales, para consultar PubMed con más cuota y sin límites de cortesía
# (ver https://www.ncbi.nlm.nih.gov/account/settings/ para obtener una api_key).
NCBI_API_KEY=
NCBI_EMAIL=

# Almacén compartido (Upstash Redis, nivel gratuito). Se crea en un par de
# clics desde el propio panel de Vercel: pestaña "Storage" del proyecto →
# "Create Database" → "Upstash for Redis" (o similar); Vercel añade estas
# variables automáticamente.
#
# Necesario para el registro/inicio de sesión (api/register.js, api/login.js
# fallan con un error claro si no está configurado): aquí se guardan las
# cuentas de usuario y las sesiones activas.
#
# También sirve como caché opcional de los alimentos que la IA genera, para
# que se guarden una sola vez y se compartan entre todas las visitas — eso sí
# sigue siendo opcional: sin esto, la búsqueda con IA funciona igual, pero
# cada persona la repite para sí misma en vez de beneficiarse de lo que ya
# buscaron otros.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: nombres de usuario (separados por comas si hay varios) con
# permisos de administrador sobre las Recetas de la Comunidad — pueden borrar
# cualquier receta ajena (moderación), no solo las suyas. No editable desde
# la web, solo cambiando esta variable en Vercel.
ADMIN_USERNAMES=HSNutricion
